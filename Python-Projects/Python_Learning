lio market value\n","portfolio_val = pd.Series(0.0, index=data.index)\n","for ticker, qty in portfolio.items():\n","  if ticker in data.columns:\n","    portfolio_val += data[ticker].fillna(0) * qty\n","\n","# Trim to valid non-zero trading days & align all benchmark indices\n","portfolio_val = portfolio_val[portfolio_val > 0]\n","nifty = nifty.reindex(portfolio_val.index).ffill()\n","gold = gold.reindex(portfolio_val.index).ffill()\n","sp500 = sp500.reindex(portfolio_val.index).ffill()\n","\n","# 4. Normalize all 4 metrics to Base 100 on Day 1\n","portfolio_norm = (portfolio_val / portfolio_val.iloc[0]) * 100\n","nifty_norm = (nifty / nifty.iloc[0]) * 100\n","gold_norm = (gold / gold.iloc[0]) * 100\n","sp500_norm = (sp500 / sp500.iloc[0]) * 100\n","\n","# Consolidate into a single DataFrame for clean animation frames\n","df_anim = pd.DataFrame({\n","    'Date': portfolio_val.index,\n","    'Portfolio': portfolio_norm.values,\n","    'Nifty50': nifty_norm.values,\n","    'Gold': gold_norm.values,\n","    'SP500': sp500_norm.values,\n","})\n","\n","# 5. Build Animated GIF Plot\n","fig, ax = plt.subplots(figsize=(12, 6))\n","\n","# Smooth frame stepping (increased number of frames for smoother, slower movement)\n","step = max(1, len(df_anim) // 200)\n","frames_list = list(range(10, len(df_anim), step)) + [len(df_anim)]\n","\n","\n","def update(frame):\n","  ax.clear()\n","  sub_df = df_anim.iloc[:frame]\n","\n","  # Customized Color Scheme\n","  ax.plot(\n","      sub_df['Date'],\n","      sub_df['Portfolio'],\n","      label='Selected Stocks',\n","      color='#d93025',\n","      linewidth=2.5,\n","  )  # Red\n","  ax.plot(\n","      sub_df['Date'],\n","      sub_df['Nifty50'],\n","      label='Nifty 50 (^NSEI)',\n","      color='#1a73e8',\n","      linewidth=2,\n","  )  # Blue\n","  ax.plot(\n","      sub_df['Date'],\n","      sub_df['Gold'],\n","      label='Gold (GOLDBEES)',\n","      color='#f9ab00',\n","      linewidth=2,\n","  )  # Yellow\n","  ax.plot(\n","      sub_df['Date'],\n","      sub_df['SP500'],\n","      label='S&P 500 (^GSPC)',\n","      color='#ff7f0e',\n","      linewidth=2,\n","      linestyle='--',\n","  )  # Orange\n","\n","  ax.set_title(\n","      '5-Year Normalized Growth: Portfolio vs Nifty 50 vs Gold vs S&P 500 (Base'\n","      ' = 100)',\n","      fontsize=14,\n","      fontweight='bold',\n","  )\n","  ax.set_xlabel('Date', fontweight='bold')\n","  ax.set_ylabel('Normalized Scale (Starts at 100)', fontweight='bold')\n","\n","  # Dynamic axis limits\n","  ax.set_ylim(\n","      min(\n","          df_anim['Portfolio'].min(),\n","          df_anim['Nifty50'].min(),\n","          df_anim['Gold'].min(),\n","          df_anim['SP500'].min(),\n","      )\n","      - 10,\n","      max(\n","          df_anim['Portfolio'].max(),\n","          df_anim['Nifty50'].max(),\n","          df_anim['Gold'].max(),\n","          df_anim['SP500'].max(),\n","      )\n","      + 20,\n","  )\n","  ax.set_xlim(df_anim['Date'].iloc[0], df_anim['Date'].iloc[-1])\n","\n","  ax.legend(loc='upper left')\n","  ax.grid(True, alpha=0.3)\n","\n","\n","print('Generating animation video...')\n","# SLOWER SPEED SETTINGS:\n","# 1. interval=100 (100 milliseconds between frames instead of 50)\n","# 2. fps=12 (12 frames per second in saved GIF makes the animation play slower)\n","ani = animation.FuncAnimation(\n","    fig, update, frames=frames_list, interval=100, repeat=False\n",")\n","\n","# 6. Save directly as a GIF in Google Colab sample_data folder\n","output_gif = '/content/sample_data/portfolio_vs_benchmarks.gif'\n","ani.save(output_gif, writer='pillow', fps=12)\n","plt.close()\n","\n","print(f'Done! GIF successfully saved to {output_gif}')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"vmlSLUsZppMp","executionInfo":{"status":"ok","timestamp":1790090281272,"user_tz":-330,"elapsed":71038,"user":{"displayName":"Rupesh Ramesh","userId":"17099937566393136880"}},"outputId":"eded64d4-d6d9-4668-ff9e-42811238c34c"},"execu